{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ade.biblionica.ru/contracts/task-envelope.schema.json",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "scope",
    "constraints",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "ade.task-envelope.v0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "required_outcome"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required_outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_digest",
        "included_entities",
        "excluded_entities"
      ],
      "properties": {
        "state_digest": {
          "$ref": "#/$defs/digest"
        },
        "included_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "required",
              "advisory"
            ]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

